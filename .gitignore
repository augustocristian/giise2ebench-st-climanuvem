# giise2ebench-st-climanuvem root .gitignore
# Covers bench-level rubbish plus IDE noise for Eclipse, VS Code, PyCharm, and IntelliJ IDEA.
# The sut/backend and sut/frontend sub-projects keep their own .gitignore files for
# stack-specific artifacts (Python venvs, node_modules, Expo/Android build output, etc.).

######################
# JetBrains (IntelliJ IDEA / PyCharm)
######################
.idea/
*.iml
*.ipr
*.iws
out/
.idea_modules/

######################
# Eclipse
######################
.project
.classpath
.settings/
.metadata/
bin/
tmp/
*.tmp
*.bak
*.swp
*~.nib
local.properties
.loadpath
.recommenders/
.externalToolBuilders/
*.launch
.pydevproject
.cproject
.buildpath
.target
.tern-project
.texlipse
.springBeans
.factorypath
.apt_generated
.apt_generated_test
.cache-main
.scala_dependencies
.worksheet

######################
# Visual Studio Code
######################
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/*.code-snippets
.history/
*.vsix

######################
# OS noise
######################
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

######################
# Editors / misc tooling
######################
*.orig
*.rej
*.log
.env
.env.*
!.env.example

######################
# Python (bench-level scripts, docs tooling, etc.)
######################
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.mypy_cache/
.pytest_cache/
.ruff_cache/
.tox/
.venv/
venv/
env/

######################
# Node (bench-level scripts, if any)
######################
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

######################
# Deployment script output
######################
*.pid
deploy.log
