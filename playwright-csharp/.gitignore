# playwright-csharp/.gitignore
# .NET/MSBuild build output plus IDE noise for Visual Studio, JetBrains Rider, and VS Code.

######################
# .NET / MSBuild build output
######################
bin/
obj/
[Dd]ebug/
[Rr]elease/
[Xx]64/
[Xx]86/
*.dll
*.exe
*.pdb

######################
# Visual Studio
######################
.vs/
*.user
*.userosscache
*.suo
*.userprefs
*.sln.docstates
*.VC.db
*.VC.VC.opendb

######################
# JetBrains Rider
######################
.idea/
*.sln.iml

######################
# Visual Studio Code
######################
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/*.code-snippets

######################
# NuGet
######################
*.nupkg
*.snupkg
**/[Pp]ackages/*
!**/[Pp]ackages/build/
*.nuget.props
*.nuget.targets

######################
# Test results / coverage
######################
TestResults/
[Tt]est[Rr]esult*/
*.trx
*.coverage
*.coveragexml
coverage.xml
coverage.cobertura.xml

######################
# Playwright
######################
playwright-report/
test-results/
blob-report/
.playwright/
ms-playwright/

######################
# Local config / secrets
######################
appsettings.*.local.json
*.local.csv
.env
.env.*
!.env.example

######################
# OS noise
######################
.DS_Store
Thumbs.db
Desktop.ini
